# Copy to .env. Each source has its own host, credentials and database.
DATABASES=books,orders
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=10

BOOKS_DB_DESCRIPTION=图书信息、价格、版本和库存
BOOKS_DB_HOST=
BOOKS_DB_PORT=3306
BOOKS_DB_USER=
BOOKS_DB_PASSWORD=
BOOKS_DB_NAME=
# Optional comma-separated table/view allowlist. Empty means all visible tables.
BOOKS_DB_TABLES=

ORDERS_DB_DESCRIPTION=订单、付款状态和订单金额
ORDERS_DB_HOST=
ORDERS_DB_PORT=3306
ORDERS_DB_USER=
ORDERS_DB_PASSWORD=
ORDERS_DB_NAME=
ORDERS_DB_TABLES=
